        ],
        "rate": "slowest"
      }
    ],
    "rank_inputs": [
      "months_elapsed",
      "creative_role.differentiation.distinct_axes",
      "branch_context.evidence_c_ratio",
      "career_change_reported"
    ],
    "double_weight_when": [
      "J_UNDIFFERENTIATED",
      "evidence_c_ratio >= 0.7"
    ],
    "notice": "신선도는 데이터의 나이에 대한 정렬이며 사람의 적합도 순위가 아니다. 일치 축 수와 곱하거나 더하지 않는다."
  },
